# .env for cec project

# User-Agent for fetching
USER_AGENT="Mozilla/5.0 (X11; Linux x86_64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/143.0.0.0 Safari/537.36"

# Comma-separated list of hosts the fetcher is allowed to request (SSRF protection)
ALLOWED_FETCH_HOSTS="farside.co.uk"

# Maximum response body size in bytes that the fetcher will accept (default: 1MB)
# MAX_FETCH_SIZE_BYTES=1048576

# URLs for ETF data (can be overridden)
ETF_BTC_URL="https://farside.co.uk/bitcoin-etf-flow-all-data/"
ETF_ETH_URL="https://farside.co.uk/ethereum-etf-flow-all-data/"
ETF_SOL_URL="https://farside.co.uk/sol/"
